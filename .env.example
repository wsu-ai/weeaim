POSTGRES_USER=venture_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=venture_platform
DATABASE_URL=postgresql+asyncpg://venture_user:changeme@localhost:5432/venture_platform
REDIS_URL=redis://localhost:6379/0

# venture_app: the running app's role. Subject to row-level security.
APP_DB_USER=venture_app
APP_DB_PASSWORD=changeme
APP_DATABASE_URL=postgresql+asyncpg://venture_app:changeme@localhost:5432/venture_platform

# venture_service: background-job role. BYPASSRLS, for legitimate cross-org jobs.
SERVICE_DB_USER=venture_service
SERVICE_DB_PASSWORD=changeme
SERVICE_DATABASE_URL=postgresql+asyncpg://venture_service:changeme@localhost:5432/venture_platform

# OpenAI (GPT-6 Astra, via the Responses API). Get a key from platform.openai.com.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
