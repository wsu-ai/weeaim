POSTGRES_USER=venture_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=venture_platform
DATABASE_URL=postgresql+asyncpg://venture_user:changeme@localhost:5432/venture_platform
REDIS_URL=redis://localhost:6379/0

# venture_app: the running app's role. Subject to row-level security.
APP_DB_USER=venture_app
APP_DB_PASSWORD=changeme
APP_DATABASE_URL=postgresql+asyncpg://venture_app:changeme@localhost:5432/venture_platform

# venture_service: background-job role. BYPASSRLS, for legitimate cross-org jobs.
SERVICE_DB_USER=venture_service
SERVICE_DB_PASSWORD=changeme
SERVICE_DATABASE_URL=postgresql+asyncpg://venture_service:changeme@localhost:5432/venture_platform

# OpenAI (GPT-6 Astra, via the Responses API). Get a key from platform.openai.com.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Sign in with Google -- see docs/google-sign-in.md.
# OAuth client ID from Google Cloud Console (public by design; no client secret needed).
GOOGLE_CLIENT_ID=
# Signs session cookies. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# SESSION_TTL_MINUTES=480

# Email for sign-up codes and notices -- see docs/sign-up-and-approval.md.
# "console" (default) prints emails, codes included, in the backend terminal.
EMAIL_BACKEND=console
# EMAIL_FROM=WEEAIM <no-reply@your-domain>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# Optional: notified when someone verifies a new sign-up.
# SIGNUP_NOTIFY_EMAIL=

# Stage 1 idea research uses OpenAI web search (with OPENAI_API_KEY above).
# Optional comma-separated domains to restrict it to; empty = whole web.
# WEB_SEARCH_ALLOWED_DOMAINS=
